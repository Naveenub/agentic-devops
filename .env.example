# Copy to .env and fill in. With no key set the agent runs in deterministic mode
# (regex signatures + runbook retrieval, no LLM calls).

# Required for POST /analyze and /cost/check: clients send it as the X-API-Key header.
# Unset = those endpoints return 503. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AGENT_API_KEY=...

# Enables LLM diagnosis (OpenAI-compatible). Uncomment and set a real key:
# OPENAI_API_KEY=sk-...
AGENT_LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:8000/v1   # local LLaMA / vLLM / Ollama-compatible server
# AGENT_LLM=off                              # force deterministic mode even if a key is set

# Enables GitHub Actions log reads (the `github` input of /analyze). Read-only: use a fine-grained
# token or GitHub App token with "Actions: read" on the repos you want to diagnose. Without it the
# CI observation is recorded as a tool error and never used as evidence.
# GITHUB_TOKEN=github_pat_...

# Slack: /slack/command replies and /cost/check anomaly alerts (bot needs chat:write).
# SLACK_BOT_TOKEN=xoxb-...
# Required for /slack/command: Slack app > Basic Information > Signing Secret. Unset = endpoint returns 503.
# SLACK_SIGNING_SECRET=...
# Optional: comma-separated channel IDs where /slack/command may run (replies go to the same channel).
# Unset = any channel the signed request comes from.
# SLACK_ALLOWED_CHANNELS=C0123456789,C0987654321
# Channel ID that /cost/check posts to when the z-score exceeds the threshold. Unset = no alert.
# SLACK_ALERT_CHANNEL=C0123456789
# Cost Explorer reads use the standard AWS credential chain (ce:GetCostAndUsage only).

# PagerDuty Events API v2 integration key; /cost/check and the scheduler page on a spike. Unset = no page.
# PAGERDUTY_ROUTING_KEY=...

# Built-in scheduler: service:region pairs, ';'-separated. Unset = no scheduler.
# Short names ec2/s3/rds/lambda/eks are expanded; other services need the exact Cost Explorer name.
# COST_WATCH=EC2:us-east-1;S3:us-east-1
# COST_CHECK_INTERVAL_SECONDS=21600   # min 60. Cost Explorer bills ~$0.01 per request.
# COST_ALERT_COOLDOWN_SECONDS=86400   # a persisting spike re-alerts after this long

# --- Commercial product layer (product/, see LICENSING.md). Unset PRODUCT_DB = open-core mode above. ---
# Setting PRODUCT_DB turns on per-tenant API keys (X-API-Key) instead of AGENT_API_KEY, plus
# rate limits, monthly quotas and usage metering. /admin/* is guarded by PRODUCT_ADMIN_KEY (unset = 503).
# PRODUCT_DB=/data/product/product.db
# PRODUCT_ADMIN_KEY=...
# Override plan quotas/limits as JSON, e.g. {"pro": {"monthly_quota": {"analyze": 20000}, "shared_tools": true}}
# PRODUCT_PLANS=
# Stripe usage reporting (POST /admin/billing/report, run it from cron). Prices/tiers live in Stripe on the meter.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_METER_ANALYZE=agent_analyze_runs
# STRIPE_METER_COST_CHECK=agent_cost_checks
# STRIPE_METER_LLM_TOKENS=agent_llm_tokens
