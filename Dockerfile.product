# Commercial image: the open-core image plus product/. Build the core first:
#   docker build -t agentic-devops-core . && docker build -f Dockerfile.product -t agentic-devops-product .
ARG BASE=agentic-devops-core
FROM ${BASE}
USER root
RUN mkdir -p /data/product /data/approvals && chown app:app /data/product /data/approvals
COPY --chown=app:app product/ product/
RUN pip install --no-cache-dir -r product/requirements.txt  # PostgreSQL driver
USER app
ENV PRODUCT_DB=/data/product/product.db
