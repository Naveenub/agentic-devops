# cp .env.production.example .env.production  (never commit it; .gitignore/.dockerignore already exclude .env.*)

# --- Hosting ---
DOMAIN=agent.example.com            # A/AAAA record must point at this host; ports 80+443 open
ACME_EMAIL=you@example.com          # Let's Encrypt expiry notices
POSTGRES_PASSWORD=                  # openssl rand -hex 24  (hex only: it is embedded in a URL)

# --- Core ---
PRODUCT_ADMIN_KEY=                  # python -c "import secrets; print(secrets.token_urlsafe(32))"
PRODUCT_SECRET_KEY=                 # 32+ chars; signs sessions, encrypts SSO secrets
# OPENAI_API_KEY=sk-...
AGENT_LLM_MODEL=gpt-4o-mini
PRODUCT_BILLING_INTERVAL=3600       # built-in Stripe usage report (seconds); needs STRIPE_* below

# --- SMTP / mailer (key-recovery emails). All three of HOST, FROM, PUBLIC_URL are required; PUBLIC_URL is set by compose from DOMAIN. ---
PRODUCT_SMTP_HOST=smtp.example.com
PRODUCT_SMTP_PORT=587               # 587 STARTTLS, 465 implicit TLS
PRODUCT_SMTP_USER=
PRODUCT_SMTP_PASSWORD=
PRODUCT_SMTP_FROM="DevOps AI Agent <no-reply@agent.example.com>"

# --- Signup ---
# Free signup gives every account 100k server-paid LLM tokens. Keep PRODUCT_SIGNUP unset/off until the cost inputs
# are measured (`make pricing-measure`, `make pricing-check`), `make legal-check` passes and mail-test works.
# PRODUCT_SIGNUP=on
# PRODUCT_CONTACT_URL=mailto:sales@example.com

# --- Stripe (optional) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # endpoint: https://<DOMAIN>/stripe/webhook
# STRIPE_METER_ANALYZE=agent_analyze_runs
# STRIPE_METER_COST_CHECK=agent_cost_checks
# STRIPE_METER_LLM_TOKENS=agent_llm_tokens
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_base,price_usage:metered
# STRIPE_SUCCESS_URL=https://agent.example.com/billing/success
# STRIPE_CANCEL_URL=https://agent.example.com/billing/cancel
# STRIPE_PORTAL_RETURN_URL=https://agent.example.com/billing

# --- Optional integrations: see .env.example (GITHUB_TOKEN, SLACK_*, PAGERDUTY_*, AWS, AGENT_PR_REPOS ...) ---
